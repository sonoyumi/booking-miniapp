# Скопируйте в .env и заполните. Сам .env в git не попадает.

# Тот же токен, что у бота записи (booking-bot): им проверяется вход через Telegram и отправляются уведомления
BOT_TOKEN=
# Кому приходят уведомления о записях и отменах из Mini App (как в боте)
ADMIN_IDS=

# Файлы бота: база записей и список услуг. Укажите пути к файлам booking-bot,
# чтобы бот и Mini App видели одни и те же записи.
DATABASE_PATH=../booking-bot/data/bookings.db
SERVICES_PATH=../booking-bot/config/services.json

# Расписание — ТЕ ЖЕ значения, что в .env бота
TIMEZONE=Europe/Rome
WORK_START=10
WORK_END=19
SLOT_MINUTES=60
DAYS_AHEAD=7
WORK_DAYS=1,2,3,4,5,6

# Название в шапке Mini App
SHOP_NAME=Barbiere Alpino
# Публичный адрес Mini App (только https://) — для кнопки меню в боте
WEBAPP_URL=
# Сколько секунд действителен вход из Telegram и сколько будущих записей может быть у одного человека
INIT_DATA_MAX_AGE=86400
MAX_ACTIVE_PER_USER=3

# ТОЛЬКО для проверки в обычном браузере без Telegram: запросы без входа идут от этого ID.
# На сервере оставьте пустым!
DEV_USER_ID=
